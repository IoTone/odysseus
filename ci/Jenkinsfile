// ci/Jenkinsfile — cross-platform CI for the Racket port of Odysseus.
//
// Design goals (see ../PORTING_PLAN.md):
//   - Build + test the port on Linux, macOS, and Windows from one pipeline.
//   - Linux is wired up now; macOS/Windows stages are written and ready but
//     gated OFF by default until labeled agents exist ("verify later").
//   - Every platform: install the *right* Racket, byte-compile, run the
//     portable Racket test suite, and build standalone binaries (raco exe).
//   - Linux additionally runs the Python-vs-Racket fidelity diffs (needs the
//     app venv, which only the Linux agent provides).
//
// Toolchain policy mirrors install-racket.sh: official Racket on Linux/Windows,
// Homebrew on macOS.

pipeline {
  agent none

  parameters {
    booleanParam(name: 'RUN_LINUX',   defaultValue: true,  description: 'Build/test on Linux (Debian/Ubuntu)')
    booleanParam(name: 'RUN_MACOS',   defaultValue: false, description: 'Build/test on macOS (needs an agent labeled "macos")')
    booleanParam(name: 'RUN_WINDOWS', defaultValue: false, description: 'Build/test on Windows (needs an agent labeled "windows")')
    booleanParam(name: 'RUN_NIX',     defaultValue: false, description: 'Exercise the flake via nix flake check (needs an agent labeled "nix")')
  }

  environment {
    RACKET_VERSION = '9.2'
  }

  options {
    timestamps()
    timeout(time: 40, unit: 'MINUTES')
  }

  stages {
    stage('Build & Test (matrix)') {
      parallel {

        // ---------------------------------------------------------------- Linux
        stage('Linux') {
          when { expression { return params.RUN_LINUX } }
          agent { label 'linux' }
          environment { RACKET_PREFIX = "${WORKSPACE}/.racket" }
          steps {
            sh '''
              set -eu
              # Official Racket, in-place under the workspace (cached across builds).
              if [ ! -x "$RACKET_PREFIX/bin/racket" ]; then
                RACKET_PREFIX="$RACKET_PREFIX" RACKET_VERSION="$RACKET_VERSION" \
                  racket/install-racket.sh
              fi
              export PATH="$RACKET_PREFIX/bin:$PATH"
              racket --version

              # Deps: catalog libs + the local spin-out packages (linked).
              raco pkg install --auto --batch --skip-installed web-server-lib db-lib || true
              raco pkg install --link --batch --skip-installed \
                racket/pkgs/cli-kit racket/pkgs/db-kit racket/pkgs/web-kit || true
              # Byte-compile (explicit entry points — cross-shell safe).
              ( cd racket && raco make config.rkt cli/odysseus-logs.rkt cli/odysseus-preset.rkt cli/odysseus-signature.rkt cli/odysseus-notes.rkt cli/odysseus-sessions.rkt cli/odysseus-tasks.rkt cli/odysseus-research.rkt cli/odysseus-mcp.rkt cli/odysseus-calendar.rkt server/main.rkt server/proxy.rkt test/run-tests.rkt test/seed-db.rkt )

              # Portable behavior suite.
              ( cd racket && racket test/run-tests.rkt )

              # Python-vs-Racket fidelity (Linux only — needs the app venv).
              python3 -m venv .venv
              . .venv/bin/activate
              pip install -q -r requirements.txt
              chmod +x ci/fidelity.sh && ci/fidelity.sh
              deactivate

              # Standalone binaries (the packaging deliverable).
              mkdir -p racket/dist
              for t in odysseus-logs odysseus-preset odysseus-signature odysseus-notes odysseus-sessions odysseus-tasks odysseus-research odysseus-mcp odysseus-calendar; do
                raco exe -o "racket/dist/$t" "racket/cli/$t.rkt"
              done
            '''
            archiveArtifacts artifacts: 'racket/dist/*', fingerprint: true, allowEmptyArchive: true
          }
        }

        // ---------------------------------------------------------------- macOS
        stage('macOS') {
          when { expression { return params.RUN_MACOS } }
          agent { label 'macos' }
          steps {
            sh '''
              set -eu
              # macOS: Homebrew is the tried-and-true path.
              command -v racket >/dev/null 2>&1 || brew install minimal-racket
              racket --version
              raco pkg install --auto --batch --skip-installed web-server-lib db-lib || true
              raco pkg install --link --batch --skip-installed \
                racket/pkgs/cli-kit racket/pkgs/db-kit racket/pkgs/web-kit || true
              ( cd racket && raco make config.rkt cli/odysseus-logs.rkt cli/odysseus-preset.rkt cli/odysseus-signature.rkt cli/odysseus-notes.rkt cli/odysseus-sessions.rkt cli/odysseus-tasks.rkt cli/odysseus-research.rkt cli/odysseus-mcp.rkt cli/odysseus-calendar.rkt server/main.rkt server/proxy.rkt test/run-tests.rkt test/seed-db.rkt )
              ( cd racket && racket test/run-tests.rkt )
              mkdir -p racket/dist
              for t in odysseus-logs odysseus-preset odysseus-signature odysseus-notes odysseus-sessions odysseus-tasks odysseus-research odysseus-mcp odysseus-calendar; do
                raco exe -o "racket/dist/$t" "racket/cli/$t.rkt"
              done
            '''
            archiveArtifacts artifacts: 'racket/dist/*', fingerprint: true, allowEmptyArchive: true
          }
        }

        // -------------------------------------------------------------- Windows
        stage('Windows') {
          when { expression { return params.RUN_WINDOWS } }
          agent { label 'windows' }
          steps {
            // PowerShell: install official Racket if absent, then build/test.
            powershell '''
              $ErrorActionPreference = "Stop"
              if (-not (Get-Command racket -ErrorAction SilentlyContinue)) {
                $ver = $env:RACKET_VERSION
                $url = "https://download.racket-lang.org/installers/$ver/racket-$ver-x86_64-win32-cs.exe"
                $exe = "$env:TEMP\\racket-install.exe"
                Invoke-WebRequest -Uri $url -OutFile $exe
                # /S = silent; /D = install dir (must be last, unquoted, NSIS convention)
                Start-Process -Wait -FilePath $exe -ArgumentList "/S","/D=C:\\racket"
                $env:Path = "C:\\racket;" + $env:Path
              }
              racket --version
              # Full Racket bundles these; install only if missing (avoids the
              # "installed in a wider scope" error on full distributions).
              racket -e "(require web-server/servlet-env db rackunit)" 2>$null
              if ($LASTEXITCODE -ne 0) { raco pkg install --auto --batch web-server-lib db-lib }
              raco pkg install --link --batch --skip-installed racket\pkgs\cli-kit racket\pkgs\db-kit racket\pkgs\web-kit
              Push-Location racket
              raco make config.rkt cli/odysseus-logs.rkt cli/odysseus-preset.rkt cli/odysseus-signature.rkt cli/odysseus-notes.rkt cli/odysseus-sessions.rkt cli/odysseus-tasks.rkt cli/odysseus-research.rkt cli/odysseus-mcp.rkt cli/odysseus-calendar.rkt server/main.rkt server/proxy.rkt test/run-tests.rkt test/seed-db.rkt
              racket test/run-tests.rkt
              New-Item -ItemType Directory -Force -Path dist | Out-Null
              foreach ($t in @("odysseus-logs","odysseus-preset","odysseus-signature","odysseus-notes","odysseus-sessions","odysseus-tasks","odysseus-research","odysseus-mcp","odysseus-calendar")) {
                raco exe -o "dist/$t.exe" "cli/$t.rkt"
              }
              Pop-Location
            '''
            archiveArtifacts artifacts: 'racket/dist/*', fingerprint: true, allowEmptyArchive: true
          }
        }

        // ------------------------------------------------------------------ Nix
        stage('Nix') {
          when { expression { return params.RUN_NIX } }
          agent { label 'nix' }
          steps {
            // `nix flake check` builds packages.odysseus (its checkPhase runs the
            // Racket test suite) + validates devShells/apps. The flake pins
            // nixpkgs via flake.lock, so this is reproducible.
            sh 'nix --extra-experimental-features "nix-command flakes" flake check -L'
          }
        }
      }
    }
  }

  post {
    always {
      node('linux') {
        echo 'CI complete. Linux is wired up; flip RUN_MACOS / RUN_WINDOWS once agents exist.'
      }
    }
  }
}
